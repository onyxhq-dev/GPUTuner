<FILE Name="&dir;/images/GPUTuner.png">
<URL>&raw;/assets/logo.png</URL>
<SHA256>a3ba6c9ea1096a29dc8fa0d0817e128c35b45f377cd073311194e4cc3350f9b9</SHA256>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
set -e
command -v nvidia-smi &gt;/dev/null || echo "WARNING: nvidia-smi not found. Install the NVIDIA Driver plugin."

mkdir -p /usr/local/lib/gputuner
cp &boot;/gputuner-&version; /usr/local/lib/gputuner/gputuner
chmod 755 /usr/local/lib/gputuner/gputuner

for f in &boot;/gputuner-*; do [ "$f" = "&boot;/gputuner-&version;" ] || rm -f "$f"; done
rm -f &boot;/upstream-*.tar.gz &boot;/python-*.tar.gz &boot;/nvidia_ml_py-*.whl

sed -i 's/\r//' &dir;/rc.gputuner &dir;/event/*
chmod +x &dir;/rc.gputuner &dir;/event/*

[ -f &boot;/gputuner.cfg ] || printf 'SERVICE="disable"\n' &gt; &boot;/gputuner.cfg
sed -i '/^DATA_DIR=/d' &boot;/gputuner.cfg

OLD=/mnt/user/appdata/gputuner
if [ -d $OLD/state ] &amp;&amp; [ ! -d &boot;/data ]; then
  mkdir -p &boot;/data &amp;&amp; cp -r $OLD/config $OLD/state &boot;/data/
fi

if [ -f /var/run/gputuner.restart ] || grep -q '^SERVICE="enable"' &boot;/gputuner.cfg; then
  &dir;/rc.gputuner start || true
fi
rm -f /var/run/gputuner.restart

echo "----------------------------------------------------"
echo " GPUTuner installed successfully."
echo " Go to Settings &gt; Utilities &gt; GPU Tuner and start the service."
echo "----------------------------------------------------"
exit 0
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
&dir;/rc.gputuner stop 2&gt;/dev/null
rm -rf &dir; /usr/local/lib/gputuner
find &boot; -mindepth 1 -maxdepth 1 ! -name data -exec rm -rf {} +
echo "GPUTuner removed."
exit 0
</INLINE>
</FILE>

</PLUGIN>
