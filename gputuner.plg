<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "GPUTuner">
<!ENTITY author    "onyxhq-dev">
<!ENTITY version   "2026.11.01q">
<!ENTITY launch    "Settings/GPUTuner">
<!ENTITY pluginURL "https://raw.githubusercontent.com/onyxhq-dev/GPUTuner/master/gputuner.plg">
<!ENTITY raw       "https://raw.githubusercontent.com/onyxhq-dev/GPUTuner/master">
<!ENTITY dir       "/usr/local/emhttp/plugins/GPUTuner">
<!ENTITY boot      "/boot/config/plugins/gputuner">
<!ENTITY binsha    "25c3e88ccbb32eb4bae052bbf5392576578b2d22ff017a80f2aa19fcba713fed">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.12" icon="microchip" support="https://github.com/onyxhq-dev/GPUTuner">

<CHANGES>
## GPUTuner - NVIDIA GPU power, fan and clock control for Unraid
## 2026.11.01q
- README: native binary footprint

## 2026.11.01p
- Rewrite the service in Rust: one native binary, about 3 MB of RAM, no Python

## 2026.11.01o
- Save history across reboots: per-minute data on flash, 24h/7d/30d ranges, pick a past day, Save history switch

## 2026.11.01n
- Rewrite README, plain MIT license

## 2026.11.01m
- New logo: GPU fan inside a tuning gauge

## 2026.11.01l
- Polish the page: throttle reason chips, tile captions, aligned control panels, segmented history switch

## 2026.11.01k
- Live readings refresh every second from a RAM file, no process per refresh

## 2026.11.01j
- Restart the service after a plugin update if it was running

## 2026.11.01i
- Add history charts: 5s sampler in RAM, 15 min / 1 h / 6 h windows

## 2026.11.01h
- Redesign settings page: status bar, stat tiles with meters, sliders per control panel

## 2026.11.01g
- Fix Start button and live data: rely on Unraid's own CSRF check

## 2026.11.01f
- Show the service log on the settings page

## 2026.11.01e
- Store data on the flash drive, remove custom data path setting

## 2026.11.01d
- Bundle Python 3.12, no host Python needed

## 2026.11.01c
- Update

## 2026.11.01b
- Remove unneeded code comments

## 2026.11.01a
- Initial release. Native plugin (no Docker, no separate web UI or password): live readings, power limit, fan curve/fixed speed, clock cap and combined power budget per card, all inside Settings > Utilities > GPU Tuner
</CHANGES>

<FILE Run="/bin/bash">
<INLINE>
if [ -x &dir;/rc.gputuner ] &amp;&amp; &dir;/rc.gputuner status &gt;/dev/null 2&gt;&amp;1; then
  touch /var/run/gputuner.restart
  &dir;/rc.gputuner stop 2&gt;/dev/null
fi
rm -rf &dir; /usr/local/lib/gputuner
mkdir -p &dir;/event &dir;/images &boot;
exit 0
</INLINE>
</FILE>

<FILE Name="&boot;/gputuner-&version;">
<URL>https://github.com/onyxhq-dev/GPUTuner/releases/download/&version;/gputuner-x86_64</URL>
<SHA256>&binsha;</SHA256>
</FILE>

<FILE Name="&dir;/GPUTuner.page">
<URL>&raw;/source/GPUTuner.page</URL>
<SHA256>667956a76f1e41f4a5ef06a3cc91ccd16a408dd2946617ca80ac009142843834</SHA256>
</FILE>

