Menu="Utilities"
Title="GPU Tuner"
Icon="GPUTuner.png"
---
<?
$cfgf = "/boot/config/plugins/gputuner/gputuner.cfg";
$c = array_merge(["SERVICE"=>"disable","HISTORY"=>"enable"], @parse_ini_file($cfgf) ?: []);
$rc = "/usr/local/emhttp/plugins/GPUTuner/rc.gputuner";
$msg = "";
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
  $a = $_POST['action'] ?? '';
  if ($a === 'save') {
    $c['SERVICE'] = ($_POST['SERVICE'] ?? '') === 'enable' ? 'enable' : 'disable';
    $c['HISTORY'] = ($_POST['HISTORY'] ?? '') === 'disable' ? 'disable' : 'enable';
    file_put_contents($cfgf, "SERVICE=\"{$c['SERVICE']}\"\nHISTORY=\"{$c['HISTORY']}\"\n");
    $msg = "Saved.";
  } elseif (in_array($a, ['start','stop','restart'])) {
    $msg = htmlspecialchars(trim((string)shell_exec("$rc $a 2>&1")));
  }
}
exec("$rc status", $o, $st); $up = ($st === 0);
$tok = htmlspecialchars($var['csrf_token']);
$log = trim((string)@shell_exec("tail -n 40 /var/log/gputuner.log 2>/dev/null"));
?>
<style>
.gt{--line:rgba(128,128,128,.32);--soft:rgba(128,128,128,.10);--ok:#2ea44f;--warn:#e9a100;--bad:#e5484d;--acc:#ff8c2f;--r:8px}
.gt *{box-sizing:border-box}
.gt [hidden]{display:none!important}
.gt button,.gt select,.gt input{margin:0;vertical-align:middle}
.gt select,.gt input[type=number]{height:30px;padding:0 8px}
.gt input[type=number]{width:76px}
.gt input[type=range]{flex:1;min-width:80px;padding:0;height:20px}
.gt input[type=range],.gt input[type=checkbox]{accent-color:var(--acc)}
.gt button{height:30px;padding:0 14px;cursor:pointer}
.gt button:disabled,.gt select:disabled,.gt input:disabled{opacity:.45;cursor:default}
.gt .gt-apply{background:var(--acc);color:#1b1b1b;border:0;border-radius:4px;font-weight:bold;padding:0 20px}
.gt .gt-apply:disabled{background:var(--soft);color:inherit}
.gt-grow{flex:1}
.gt-sub{opacity:.68;font-size:.88em}
.gt-unit{opacity:.75;min-width:1.6em}

.gt-bar,.gt-sum{display:flex;flex-wrap:wrap;align-items:center;gap:10px 14px;padding:12px 16px;border:1px solid var(--line);border-radius:var(--r);margin:0 0 16px}
.gt-bar form,.gt-sum .gt-bud{display:flex;align-items:center;gap:8px;margin:0}
.gt-pill{display:inline-flex;align-items:center;gap:8px;font-weight:bold;height:30px;padding:0 14px;border-radius:99px;background:var(--soft)}
.gt-pill::before{content:"";width:9px;height:9px;border-radius:50%;background:var(--bad)}
.gt-pill.on::before{background:var(--ok);box-shadow:0 0 0 3px rgba(46,164,79,.25)}
.gt-total{display:flex;flex-direction:column;line-height:1.2}
.gt-total small{opacity:.65;text-transform:uppercase;letter-spacing:.05em;font-size:.7em}
.gt-total b{font-size:1.35em}
.gt-note{border-left:4px solid var(--warn);padding:8px 14px;margin:0 0 14px;background:var(--soft);border-radius:0 6px 6px 0}

.gt-card{border:1px solid var(--line);border-radius:var(--r);margin:0 0 20px;overflow:hidden}
.gt-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 16px;padding:14px 16px;background:var(--soft);border-bottom:1px solid var(--line)}
.gt-id{display:flex;flex-direction:column;gap:3px;min-width:0}
.gt-id h3{margin:0;font-size:1.25em;line-height:1.2;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.gt-idx{font-size:.62em;font-weight:bold;letter-spacing:.06em;text-transform:uppercase;padding:2px 9px;border-radius:99px;background:var(--acc);color:#1b1b1b}
.gt-chips{display:flex;flex-wrap:wrap;gap:6px}
.gt-chip{font-size:.88em;font-weight:bold;padding:4px 13px;border-radius:99px;background:var(--soft)}
.gt-chip.ok{background:rgba(46,164,79,.18);color:var(--ok)}
.gt-chip.warn{background:rgba(233,161,0,.18);color:var(--warn)}
.gt-chip.bad{background:rgba(229,72,77,.18);color:var(--bad)}

.gt-tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;padding:16px 16px 4px}
.gt-tile{border:1px solid var(--line);border-radius:6px;padding:10px 12px;display:flex;flex-direction:column;gap:4px}
.gt-tile small{opacity:.65;text-transform:uppercase;letter-spacing:.05em;font-size:.7em}
.gt-tile b{font-size:1.5em;line-height:1.1;white-space:nowrap}
.gt-tile b.warn{color:var(--warn)}.gt-tile b.bad{color:var(--bad)}
.gt-tile em{font-style:normal;opacity:.62;font-size:.8em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.gt-meter{height:5px;border-radius:3px;background:var(--soft);overflow:hidden;margin:2px 0}
.gt-meter i{display:block;height:100%;width:0;background:var(--acc);transition:width 1s linear}

.gt-panels{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:12px;padding:12px 16px 16px}
.gt-panel{border:1px solid var(--line);border-radius:6px;padding:12px 14px;display:flex;flex-direction:column;gap:12px}
.gt-ph{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.gt-ph h4{margin:0;font-size:1.02em}
.gt-body{display:flex;flex-direction:column;gap:10px;flex:1}
.gt-pf{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:30px}
.gt-row{display:flex;align-items:center;gap:8px}
.gt-row.wrap{flex-wrap:wrap}
.gt-row select{flex:1;min-width:0}
.gt-row label{font-weight:normal;cursor:pointer}
.gt-presets{display:flex;flex-wrap:wrap;gap:6px}
.gt-presets button{height:26px;padding:0 10px;font-size:.85em}
.gt-msg{opacity:.8;font-size:.86em}
.gt-err{color:var(--bad);opacity:1}
.gt-ok{color:var(--ok);opacity:1}
.gt-foot{display:flex;flex-wrap:wrap;align-items:center;gap:10px;padding:0 16px 16px}

.gt-histbar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px;padding:12px 16px 0;border-top:1px solid var(--line)}
.gt-histbar h4{margin:0}
.gt-histctl{display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px}
.gt-histctl input[type=date]{height:28px;padding:0 6px}
.gt-seg{display:inline-flex}
.gt-seg button{border-radius:0;margin-left:-1px;border:1px solid var(--line);background:transparent;color:inherit;height:28px;padding:0 14px}
.gt-seg button:first-child{border-radius:5px 0 0 5px;margin-left:0}
.gt-seg button:last-child{border-radius:0 5px 5px 0}
.gt-seg button.on{background:var(--acc);border-color:var(--acc);color:#1b1b1b;font-weight:bold}
.gt-hist{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:12px;padding:12px 16px 16px}
.gt-chart{border:1px solid var(--line);border-radius:6px;padding:10px 12px}
.gt-chart h5{margin:0 0 6px;font-size:.95em;display:flex;flex-wrap:wrap;gap:2px 14px;align-items:baseline}
.gt-chart h5 span{font-weight:normal;font-size:.85em;opacity:.85;white-space:nowrap}
.gt-chart h5 span::before{content:"";display:inline-block;width:10px;height:3px;margin-right:5px;vertical-align:middle;background:var(--c)}
.gt-chart canvas{width:100%;height:120px;display:block}

.gt details{margin:8px 0 16px}
.gt pre{max-height:260px;overflow:auto;padding:10px;border:1px solid var(--line);border-radius:6px;white-space:pre-wrap}
</style>

<div class="gt">

<div class="gt-bar">
  <span class="gt-pill <?=$up ? 'on' : ''?>"><?=$up ? 'Running' : 'Stopped'?></span>
  <form method="post">
    <input type="hidden" name="csrf_token" value="<?=$tok?>">
    <? foreach (['start','stop','restart'] as $b): ?>
    <button name="action" value="<?=$b?>"<?=($b === 'start' && $up) || ($b === 'stop' && !$up) ? ' disabled' : ''?>><?=ucfirst($b)?></button>
    <? endforeach; ?>
  </form>
  <span class="gt-grow"></span>
  <form method="post">
    <input type="hidden" name="csrf_token" value="<?=$tok?>"><input type="hidden" name="action" value="save">
    <label for="gt-hist">Save history</label>
    <select id="gt-hist" name="HISTORY" onchange="this.form.submit()" title="Keeps 30 days of per-minute history on the flash drive"><option value="enable">Yes</option><option value="disable" <?=$c['HISTORY']=='disable'?'selected':''?>>No</option></select>
    <label for="gt-auto" style="margin-left:10px">Start with array</label>
    <select id="gt-auto" name="SERVICE" onchange="this.form.submit()"><option value="disable">No</option><option value="enable" <?=$c['SERVICE']=='enable'?'selected':''?>>Yes</option></select>
  </form>
</div>

<? if ($msg): ?><div class="gt-note"><?=$msg?></div><? endif; ?>

<? if (!$up): ?>
<p>The service is stopped. Press <b>Start</b> to see and control your GPUs. Requires the NVIDIA Driver plugin.</p>
<? else: ?>
<div id="gt-top"></div>
<div id="gt-gpus"><p>Loading...</p></div>
<p class="gt-sub">Changes act on the real GPU and are checked by the root daemon (power range, budget, fan safety floor). Stopping the service hands fans back to the driver; power limits stay applied.</p>
<? endif; ?>

<? if ($log !== ''): ?>
<details<?=$up ? '' : ' open'?>><summary>Service log</summary><pre><?=htmlspecialchars($log)?></pre></details>
<? endif; ?>

</div>

<? if ($up): ?>
<script>
(function(){
const CSRF = <?=json_encode($var['csrf_token'])?>, API = '/plugins/GPUTuner/api.php';
const cards = {}, top = document.getElementById('gt-top'), box = document.getElementById('gt-gpus');
let topEl = null;

function h(tag, attrs, ...kids){
  const e = document.createElement(tag);
  for (const [k,v] of Object.entries(attrs||{})) { if (k==='class') e.className=v; else if (k.startsWith('on')) e[k]=v; else e.setAttribute(k,v); }
  for (const k of kids) e.append(k);
  return e;
}
const call = body => $.post(API, Object.assign({csrf_token: CSRF}, body), null, 'json');
const num = (v, d=0) => (v==null || isNaN(v)) ? '-' : (+v).toFixed(d);
const pct = (a, b) => (a==null || !b) ? 0 : Math.max(0, Math.min(100, a / b * 100));

const REASON = {
  idle: ['Idle', 'mute'], app_clocks: ['App clocks', 'mute'], sync_boost: ['Sync boost', 'mute'], display_clock: ['Display clock', 'mute'],
  sw_power_cap: ['Power cap', 'warn'], sw_thermal: ['Thermal limit', 'warn'],
  hw_slowdown: ['Hardware slowdown', 'bad'], hw_thermal: ['Thermal slowdown', 'bad'], hw_power_brake: ['Power brake', 'bad'],
};

function say(el, text, kind){ el.textContent = text; el.className = 'gt-msg' + (kind ? ' gt-' + kind : ''); }

function send(card, group, req, msgEl, okText){
  say(msgEl, 'Applying...');
  call({op:'apply', req: JSON.stringify(req)}).done(r => {
    if (r.ok) { card.dirty[group] = false; say(msgEl, okText, 'ok'); applyStatus(r); }
    else if (r.over_budget && req.op==='set_power' && !req.confirm_override &&
             confirm((r.error||'Over the power budget.') + '\n\nApply anyway?')) send(card, group, {...req, confirm_override:true}, msgEl, okText);
    else say(msgEl, r.error || 'Failed', 'err');
  }).fail(() => say(msgEl, 'Request failed', 'err'));
}

function tile(label){
  const val = h('b'), fill = h('i'), cap = h('em');
  return {el: h('div', {class:'gt-tile'}, h('small', {}, label), val, h('div', {class:'gt-meter'}, fill), cap), val, fill, cap};
}

function slider(step, onchange){
  const n = h('input', {type:'number', step}), r = h('input', {type:'range', step});
  n.oninput = () => { r.value = n.value; onchange(); };
  r.oninput = () => { n.value = r.value; onchange(); };
  return {n, r,
    set: v => { n.value = r.value = v; },
    limits: (a, b) => { n.min = r.min = a; n.max = r.max = b; }};
}

function panel(title){
  const hint = h('span', {class:'gt-sub'}), body = h('div', {class:'gt-body'}), msg = h('span', {class:'gt-msg'}), btn = h('button', {class:'gt-apply'}, 'Apply');
  return {hint, body, msg, btn,
    el: h('div', {class:'gt-panel'}, h('div', {class:'gt-ph'}, h('h4', {}, title), hint), body, h('div', {class:'gt-pf'}, msg, btn))};
}

const WINDOWS = [[900, '15 min'], [3600, '1 hour'], [21600, '6 hours'], [86400, '24 hours'], [604800, '7 days'], [2592000, '30 days']];
const CHARTS = [
  {title: 'Temperature & fan', max: 100, series: [{k:'temp', label:'Temp', unit:'°C', color:'#ff8c2f'}, {k:'fan', label:'Fan', unit:'%', color:'#3b9cff'}]},
  {title: 'Power', series: [{k:'power', label:'Draw', unit:'W', color:'#ff8c2f'}, {k:'limit', label:'Limit', unit:'W', color:'#3b9cff', dash:true}]},
  {title: 'Core clock', series: [{k:'clock', label:'Clock', unit:'MHz', color:'#2ea44f'}]},
  {title: 'Utilization & VRAM', max: 100, series: [{k:'util', label:'GPU', unit:'%', color:'#a371f7'}, {k:'vram', label:'VRAM', unit:'%', color:'#3b9cff'}]},
];
let histWin = 900, histDay = null;
try { histWin = +localStorage.getItem('gt-win') || 900; } catch (e) {}
if (!WINDOWS.some(w => w[0] === histWin)) histWin = 900;

function legend(ch, d){
  ch.legend.replaceChildren(h('b', {}, ch.def.title), ...ch.def.series.map(s => {
    const vals = ((d && d[s.k]) || []).filter(v => v != null);
    const last = vals.length ? vals[vals.length - 1] : null;
    return h('span', {style: '--c:' + s.color}, `${s.label} ${num(last)} ${s.unit}` + (vals.length ? ` (max ${num(Math.max(...vals))})` : ''));
  }));
}

function drawChart(ch, t, d){
  const cv = ch.canvas, dpr = window.devicePixelRatio || 1, W = cv.clientWidth, H = cv.clientHeight;
  if (!W) return;
  cv.width = W * dpr; cv.height = H * dpr;
  const x = cv.getContext('2d'); x.scale(dpr, dpr);
  x.font = '10px sans-serif'; x.fillStyle = getComputedStyle(cv).color;
  legend(ch, d);
  const all = ch.def.series.flatMap(s => ((d || {})[s.k] || []).filter(v => v != null));
  if (!t || t.length < 2 || !all.length) {
    x.textAlign = 'center'; x.globalAlpha = .7;
    x.fillText(histDay || histWin > 21600 ? 'No data for this period' : 'Collecting data...', W / 2, H / 2);
    return;
  }
  const padL = 34, padR = 4, padT = 6, padB = 16, pw = W - padL - padR, ph = H - padT - padB;
  const top = Math.max(1, ...all) * 1.05, pow = Math.pow(10, Math.floor(Math.log10(top)));
  const max = ch.def.max || [1, 2, 2.5, 4, 5, 8, 10].map(m => m * pow).find(v => v >= top);
  const t0 = t[0], span = Math.max(1, t[t.length - 1] - t0);
  const X = ts => padL + (ts - t0) / span * pw, Y = v => padT + ph - Math.min(v, max) / max * ph;
  x.strokeStyle = 'rgba(128,128,128,.25)'; x.lineWidth = 1; x.globalAlpha = .75;
  x.textAlign = 'right';
  for (let i = 0; i <= 4; i++) {
    const v = max * i / 4, y = Y(v);
    x.beginPath(); x.moveTo(padL, y); x.lineTo(W - padR, y); x.stroke();
    x.fillText(Math.round(v), padL - 4, y + 3);
  }
  const p2 = n => String(n).padStart(2, '0');
  const label = ts => {
    const dt = new Date(ts * 1000), md = p2(dt.getMonth() + 1) + '-' + p2(dt.getDate()), hm = p2(dt.getHours()) + ':' + p2(dt.getMinutes());
    return span > 4 * 86400 ? md : span > 86400 ? md + ' ' + hm : hm;
  };
  for (let i = 0; i <= 3; i++) {
    x.textAlign = i === 0 ? 'left' : i === 3 ? 'right' : 'center';
    x.fillText(label(t0 + span * i / 3), padL + pw * i / 3, H - 3);
  }
  x.globalAlpha = 1;
  const gap = Math.max(30, (t[1] - t[0]) * 3);
  for (const s of ch.def.series) {
    x.strokeStyle = s.color; x.lineWidth = 1.6; x.setLineDash(s.dash ? [5, 4] : []);
    x.beginPath();
    let pen = false, last = null;
    (d[s.k] || []).forEach((v, i) => {
      if (v == null) return;
      if (last != null && t[i] - t[last] > gap) pen = false;
      if (pen) x.lineTo(X(t[i]), Y(v)); else { x.moveTo(X(t[i]), Y(v)); pen = true; }
      last = i;
    });
    x.stroke();
  }
  x.setLineDash([]);
}

function histRequest(){
  if (!histDay) return {window: histWin};
  const [y, m, d] = histDay.split('-').map(Number);
  return {from: Math.floor(new Date(y, m - 1, d).getTime() / 1000), to: Math.floor(new Date(y, m - 1, d + 1).getTime() / 1000)};
}

function fetchHist(){
  call(Object.assign({op:'history'}, histRequest())).done(r => {
    if (!r.ok) return;
    for (const [uuid, c] of Object.entries(cards)) for (const ch of c.charts) drawChart(ch, r.t, (r.gpus || {})[uuid] || {});
  });
}

function setWin(w){
  histWin = w; histDay = null;
  try { localStorage.setItem('gt-win', String(w)); } catch (e) {}
  for (const c of Object.values(cards)) { c.winBtns.forEach(([ws, b]) => b.classList.toggle('on', ws === w)); c.dayIn.value = ''; }
  fetchHist();
}

function setDay(v){
  if (!v) return setWin(histWin);
  histDay = v;
  for (const c of Object.values(cards)) { c.winBtns.forEach(([, b]) => b.classList.remove('on')); c.dayIn.value = v; }
  fetchHist();
}

function build(g){
  const c = {dirty:{}, uuid:g.uuid, g};
  const dirty = grp => () => { c.dirty[grp] = true; };

  c.title = h('span'); c.sub = h('div', {class:'gt-sub'}); c.chips = h('div', {class:'gt-chips'});
  const head = h('div', {class:'gt-head'}, h('div', {class:'gt-id'}, h('h3', {}, h('span', {class:'gt-idx'}, 'GPU ' + g.index), c.title), c.sub), c.chips);

  c.tiles = {};
  const tl = h('div', {class:'gt-tiles'});
  for (const k of ['Temperature','Fan','Power','Core clock','Utilization','VRAM']) { c.tiles[k] = tile(k); tl.append(c.tiles[k].el); }

  const P = c.P = panel('Power limit');
  c.pS = slider(1, dirty('p')); c.pPre = h('div', {class:'gt-presets'});
  P.body.append(h('div', {class:'gt-row'}, c.pS.r, c.pS.n, h('span', {class:'gt-unit'}, 'W')), c.pPre);
  P.btn.onclick = () => send(c, 'p', {op:'set_power', uuid:g.uuid, watts:+c.pS.n.value}, P.msg, 'Power limit applied.');

  const F = c.F = panel('Fan');
  c.fMode = h('select', {onchange: () => { dirty('f')(); fanVis(c); }},
    h('option', {value:'auto'}, 'Driver default'), h('option', {value:'curve'}, 'Curve'), h('option', {value:'manual'}, 'Fixed speed'));
  c.fCurve = h('select', {onchange: dirty('f')});
  c.fS = slider(1, dirty('f')); c.fInfo = h('div', {class:'gt-sub'});
  c.fCurveRow = h('div', {class:'gt-row'}, h('span', {class:'gt-sub'}, 'Preset'), c.fCurve);
  c.fManualRow = h('div', {class:'gt-row'}, c.fS.r, c.fS.n, h('span', {class:'gt-unit'}, '%'));
  F.body.append(h('div', {class:'gt-row'}, c.fMode), c.fCurveRow, c.fManualRow, c.fInfo);
  F.btn.onclick = () => {
    const st = c.st.settings.fan, presets = c.stAll.curve_presets || {};
    const curve = presets[c.fCurve.value] ? presets[c.fCurve.value].curve : st.curve;
    send(c, 'f', {op:'set_fan', uuid:g.uuid, mode:c.fMode.value, curve, manual_pct:+c.fS.n.value || st.manual_pct}, F.msg, 'Fan setting applied.');
  };

  const C = c.C = panel('Core clock cap');
  c.cS = slider(15, dirty('c'));
  c.cOff = h('input', {type:'checkbox', id:'cap-' + g.index, onchange: () => { dirty('c')(); capLock(c); }});
  C.body.append(h('div', {class:'gt-row'}, c.cS.r, c.cS.n, h('span', {class:'gt-unit'}, 'MHz')),
    h('div', {class:'gt-row'}, c.cOff, h('label', {for:'cap-' + g.index}, 'No cap (full boost)')));
  C.btn.onclick = () => send(c, 'c', {op:'set_clock_cap', uuid:g.uuid, mhz:c.cOff.checked ? null : +c.cS.n.value}, C.msg, 'Clock cap applied.');

  c.panels = h('div', {class:'gt-panels'}, P.el, F.el, C.el);

  c.rMsg = h('span', {class:'gt-msg'});
  c.rBtn = h('button', {onclick: () => { if (confirm('Reset fan curve, clock cap and power limit to safe defaults?')) send(c, 'r', {op:'baseline', uuid:g.uuid}, c.rMsg, 'Reset to defaults.'); }}, 'Reset to defaults');
  c.foot = h('div', {class:'gt-foot'}, c.rBtn, c.rMsg);

  c.winBtns = WINDOWS.map(([w, label]) => [w, h('button', {class: !histDay && w === histWin ? 'on' : '', onclick: () => setWin(w)}, label)]);
  c.dayIn = h('input', {type:'date', title:'Look at a past day', max: new Date().toLocaleDateString('sv-SE'), value: histDay || '', onchange: () => setDay(c.dayIn.value)});
  c.charts = CHARTS.map(def => {
    const lg = h('h5'), canvas = h('canvas');
    return {def, legend: lg, canvas, el: h('div', {class:'gt-chart'}, lg, canvas)};
  });
  const amdNote = g.vendor === 'amd'
    ? h('div', {class:'gt-note', style:'margin:12px 16px 0'}, 'AMD support is in testing. Changes are written to your real GPU and have not been verified on every card, so use it at your own risk. Clock caps are not available for AMD yet.')
    : '';
  c.el = h('div', {class:'gt-card'}, head, amdNote, tl, c.panels, c.foot,
    h('div', {class:'gt-histbar'}, h('h4', {}, 'History'),
      h('div', {class:'gt-histctl'}, h('div', {class:'gt-seg'}, ...c.winBtns.map(x => x[1])), h('label', {class:'gt-sub'}, 'or day'), c.dayIn)),
    h('div', {class:'gt-hist'}, ...c.charts.map(ch => ch.el)));
  for (const ch of c.charts) legend(ch, null);
  return c;
}

function fanVis(c){
  c.fCurveRow.hidden = c.fMode.value !== 'curve';
  c.fManualRow.hidden = c.fMode.value !== 'manual';
}

function capLock(c){ c.cS.n.disabled = c.cS.r.disabled = c.cOff.checked; }

function fillStatic(c, st, all){
  const g = c.g;
  c.st = st; c.stAll = all;
  const locked = !!all.preview || st.settings.fan.mode === 'unmanaged';

  c.P.el.hidden = !st.power_range;
  if (st.power_range) {
    c.P.hint.textContent = `${st.power_range[0]}-${st.power_range[1]} W`;
    c.pS.limits(st.power_range[0], st.power_range[1]);
    if (!c.dirty.p && st.settings.power_w != null) c.pS.set(st.settings.power_w);
    c.pPre.replaceChildren(...((st.profile && st.profile.power_presets) || []).map(p =>
      h('button', {title: p.note || '', onclick: () => { c.pS.set(p.w); c.dirty.p = true; }}, p.label || (p.w + ' W'))));
    c.pPre.hidden = !c.pPre.children.length;
  }

  c.F.el.hidden = !g.nfans;
  if (g.nfans) {
    const f = st.settings.fan, presets = all.curve_presets || {};
    c.F.hint.textContent = `${g.nfans} fan${g.nfans > 1 ? 's' : ''} · min ${st.fan_min} %`;
    c.fCurve.replaceChildren(h('option', {value:''}, 'Current curve'), ...Object.entries(presets)
      .filter(([, p]) => p.curve[p.curve.length - 1][0] <= st.full_by_c).map(([k, p]) => h('option', {value:k, title:p.note || ''}, p.label)));
    c.fS.limits(st.fan_min, 100);
    if (!c.dirty.f) { c.fMode.value = f.mode === 'unmanaged' ? 'auto' : f.mode; c.fS.set(f.manual_pct); }
    fanVis(c);
    c.fInfo.textContent = st.fan && st.fan.floor_active ? 'Safety floor active: the card is hot, the fan runs above your setting.' : (st.fan && st.fan.fault ? 'Fault: ' + st.fan.fault : '');
    c.fInfo.hidden = !c.fInfo.textContent;
  }

  c.C.el.hidden = !st.clock_range;
  if (st.clock_range) {
    c.C.hint.textContent = `${st.clock_range[0]}-${st.clock_range[1]} MHz`;
    c.cS.limits(st.clock_range[0], st.clock_range[1]);
    if (!c.dirty.c) {
      c.cOff.checked = st.settings.clock_cap_mhz == null;
      c.cS.set(st.settings.clock_cap_mhz ?? st.clock_range[1]);
    }
  }

  c.panels.hidden = c.P.el.hidden && c.F.el.hidden && c.C.el.hidden;
  c.foot.hidden = locked;
  for (const el of c.panels.querySelectorAll('button,input,select')) el.disabled = locked;
  if (!locked) capLock(c);
}

function fillLive(c, s){
  s = s || {};
  const g = c.g, T = c.tiles, fans = (s.fans || []).filter(x => x != null);
  const setT = (k, text, p, cap) => { T[k].val.textContent = text; T[k].fill.style.width = p + '%'; T[k].cap.textContent = cap || ''; };
  const fan = fans.length ? Math.max(...fans) : null, slow = g.thresholds && g.thresholds.slowdown;
  setT('Temperature', num(s.temp) + ' °C', pct(s.temp, 100), slow ? `slowdown at ${slow} °C` : '');
  T.Temperature.val.className = s.temp >= 85 ? 'bad' : s.temp >= 75 ? 'warn' : '';
  setT('Fan', fan == null ? '-' : num(fan) + ' %', fan || 0, fans.length > 1 ? fans.map(f => num(f)).join(' / ') + ' %' : (g.nfans ? '1 fan' : 'no fan control'));
  setT('Power', num(s.power_w) + ' W', pct(s.power_w, s.power_limit_w), s.power_limit_w != null ? `limit ${num(s.power_limit_w)} W` : '');
  setT('Core clock', num(s.clock_mhz) + ' MHz', pct(s.clock_mhz, g.clock_max_mhz), g.clock_max_mhz ? `max ${g.clock_max_mhz} MHz` : '');
  setT('Utilization', num(s.util) + ' %', s.util || 0, s.mem_util != null ? `memory ${num(s.mem_util)} %` : '');
  setT('VRAM', num(s.vram_used_mib / 1024, 1) + ' GB', pct(s.vram_used_mib, s.vram_total_mib), s.vram_total_mib ? `of ${num(s.vram_total_mib / 1024, 1)} GB` : '');

  const key = (s.reasons || []).join();
  if (key !== c.chipKey) {
    c.chipKey = key;
    const amd = g.vendor === 'amd';
    const items = (s.reasons && s.reasons.length)
      ? s.reasons.map(k => REASON[k] || [k, 'mute'])
      : [amd ? ['Throttle status n/a', 'mute'] : ['No limits active', 'ok']];
    if (amd) items.unshift(['AMD: in testing', 'warn']);
    c.chips.replaceChildren(...items.map(([text, kind]) => h('span', {class: 'gt-chip ' + kind}, text)));
  }
  const pci = (g.pci || '').replace(/^0+:/, '');
  c.sub.textContent = [pci && 'PCIe ' + pci, s.pstate != null ? 'P' + s.pstate : null, g.mem_kind === 'unified' ? 'shared memory' : null].filter(Boolean).join(' · ');
}

function applyStatus(st){
  if (!st || !st.gpus) return;
  for (const g of st.gpus) if (cards[g.uuid]) fillStatic(cards[g.uuid], g, st);
  renderTop(st);
}

function renderTop(st, extraWarning){
  if (!topEl) { topEl = h('div'); top.append(topEl); }
  const kids = [];
  for (const w of [...(st.warnings || []), ...(extraWarning ? [extraWarning] : [])]) kids.push(h('div', {class:'gt-note'}, w));
  if (st.preview) kids.push(h('div', {class:'gt-note'}, 'Monitor only: the control daemon is not reachable, controls are locked.'));
  else if (st.power_settable) {
    const inp = h('input', {type:'number', step:1, value: st.budget_w ?? '', placeholder:'none'}), msg = h('span', {class:'gt-msg'});
    const btn = h('button', {class:'gt-apply', onclick: () => {
      say(msg, 'Applying...');
      call({op:'apply', req: JSON.stringify({op:'set_budget', watts:+inp.value})}).done(r => r.ok ? (say(msg, 'Budget applied.', 'ok'), applyStatus(r)) : say(msg, r.error || 'Failed', 'err'));
    }}, 'Apply');
    kids.push(h('div', {class:'gt-sum'},
      h('div', {class:'gt-total'}, h('small', {}, 'Total GPU power limit'), h('b', {}, num(st.budget_used_w) + ' W')),
      h('span', {class:'gt-grow'}),
      h('div', {class:'gt-bud'}, h('label', {}, 'Combined budget'), inp, h('span', {class:'gt-unit'}, 'W'), btn, msg)));
  }
  topEl.replaceChildren(...kids);
}

function notice(text, bad){
  for (const k in cards) delete cards[k];
  topEl = null; top.replaceChildren();
  box.replaceChildren(h('p', {class: bad ? 'gt-err' : ''}, text));
}

function render(d){
  if (!d.ok) return notice(d.error || 'error', true);
  if (!d.static.length) return notice('No NVIDIA GPU found.');
  if (box.querySelector('p')) box.replaceChildren();
  const stat = {};
  for (const g of (d.status && d.status.gpus) || []) stat[g.uuid] = g;
  let created = false;
  for (const g of d.static) {
    let c = cards[g.uuid];
    if (!c) { c = cards[g.uuid] = build(g); box.append(c.el); created = true; }
    c.g = g;
    c.title.textContent = g.name;
    fillLive(c, d.live[g.uuid]);
    if (stat[g.uuid]) fillStatic(c, stat[g.uuid], d.status);
  }
  renderTop(d.status || {}, d.daemon_error ? 'Control daemon: ' + d.daemon_error : null);
  if (created) fetchHist();
}

function poll(){
  if (document.hidden) return setTimeout(poll, 3000);
  call({op:'state'}).done(render).fail(() => notice('Request failed', true)).always(() => setTimeout(poll, 3000));
}
poll();
setInterval(() => { if (!document.hidden) fetchHist(); }, 10000);

function livePoll(){
  const next = () => setTimeout(livePoll, 1000);
  if (document.hidden || !Object.keys(cards).length) return next();
  call({op:'live'}).done(r => {
    if (r.ok) for (const [uuid, c] of Object.entries(cards)) if (r.gpus[uuid]) fillLive(c, r.gpus[uuid]);
  }).always(next);
}
livePoll();
})();
</script>
<? endif; ?>
